@model IEnumerable<DigitalAgriculturalMarketplace.Models.Order>
@{
    ViewData["Title"] = "All orders";
    string StatusClass(string status) => status switch { "Pending" => "bg-warning", "Confirmed" => "bg-primary", "Completed" => "bg-success", "Cancelled" => "bg-danger", _ => "bg-secondary" };
}

<div class="container">
    <div class="page-header"><div><p class="eyebrow">Administration</p><h1 class="h2">Orders</h1><p>Review marketplace activity across farmers and consumers.</p></div><span class="badge bg-success align-self-center">@Model.Count() results</span></div>
    <form method="get" class="filter-panel"><div class="row g-3 align-items-end">
        <div class="col-lg-7"><label class="form-label" for="orderSearch">Search</label><input id="orderSearch" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Product or consumer" /></div>
        <div class="col-sm-6 col-lg-3"><label class="form-label" for="orderStatus">Status</label><select id="orderStatus" name="status" class="form-select"><option value="">All statuses</option><option value="Pending" selected="@(ViewBag.Status == "Pending")">Pending</option><option value="Confirmed" selected="@(ViewBag.Status == "Confirmed")">Confirmed</option><option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option><option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option></select></div>
        <div class="col-sm-6 col-lg-2 d-flex gap-2"><button class="btn btn-primary" type="submit">Filter</button><a asp-action="Orders" class="btn btn-secondary">Clear</a></div>
    </div></form>

    @if (!Model.Any()) { <div class="empty-state"><h2 class="h4">No orders found</h2><p class="mb-0">Try changing the filters.</p></div> }
    else
    {
        <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Order</th><th>Product</th><th>Farmer</th><th>Consumer</th><th>Qty</th><th>Total</th><th>Status</th><th>Date</th></tr></thead><tbody>
        @foreach (var order in Model)
        {
            <tr><td>#@order.Id</td><td><strong>@order.Product?.Name</strong></td><td>@order.Product?.Farmer?.Name</td><td>@order.Consumer?.Name</td><td>@order.Quantity</td><td>Rs. @order.TotalPrice.ToString("N2")</td><td><span class="badge @StatusClass(order.Status)">@order.Status</span></td><td>@order.OrderDate.ToString("dd MMM yyyy")</td></tr>
        }
        </tbody></table></div>
    }
</div>
