@model DigitalAgriculturalMarketplace.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-4">

    <h2>Order Details</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <hr />

    <div class="card">

        <div class="card-body">

            <p>
                <strong>Order ID:</strong>
                @Model.Id
            </p>
            @if (!string.IsNullOrEmpty(Model.Product?.ImageUrl))
            {
                <div class="mb-3">

                    <img src="@Model.Product.ImageUrl"
                         alt="@Model.Product.Name"
                         width="180"
                         height="180"
                         style="object-fit: cover;"
                         class="rounded border" />

                </div>
            }

            <p>
                <strong>Product:</strong>
                @Model.Product?.Name
            </p>

            <p>
                <strong>Farmer:</strong>
                @Model.Product?.Farmer?.Name
            </p>

            <p>
                <strong>Quantity:</strong>
                @Model.Quantity
            </p>

            <p>
                <strong>Total Price:</strong>
                Rs. @Model.TotalPrice.ToString("N2")
            </p>

            <p>
                <strong>Order Date:</strong>
                @(Model.OrderDate.ToString("dd MMM yyyy hh:mm tt"))
            </p>

            <p>
                <strong>Status:</strong>

                @if (Model.Status == "Pending")
                {
                    <span class="badge bg-warning text-dark">
                        Pending
                    </span>
                }
                else if (Model.Status == "Confirmed")
                {
                    <span class="badge bg-primary">
                        Confirmed
                    </span>
                }
                else if (Model.Status == "Completed")
                {
                    <span class="badge bg-success">
                        Completed
                    </span>
                }
                else if (Model.Status == "Cancelled")
                {
                    <span class="badge bg-danger">
                        Cancelled
                    </span>
                }
                @if (Model.Status == "Completed")
                {
                    if (ViewBag.HasReviewed == true)
                    {
                        <span class="badge bg-success p-2">
                            Reviewed
                        </span>
                    }
                    else
                    {
                        <a asp-controller="Reviews"
                           asp-action="Create"
                           asp-route-productId="@Model.ProductId"
                           class="btn btn-warning">

                            Write Review

                        </a>
                    }
                }

            </p>

            <hr />

            @if (Model.Status == "Pending")
            {
                <form asp-controller="Orders"
                      asp-action="ConsumerCancelOrder"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button type="submit"
                            class="btn btn-danger">

                        Cancel Order

                    </button>

                </form>
            }
            @if (Model.Product?.Farmer != null)
            {
                <a asp-controller="Messages"
                   asp-action="Send"
                   asp-route-receiverId="@Model.Product.Farmer.Id"
                   asp-route-productId="@Model.ProductId"
                   class="btn btn-outline-primary">

                    Message Farmer

                </a>
            }

            <a asp-controller="Orders"
               asp-action="MyOrders"
               class="btn btn-secondary">

                Back to My Orders

            </a>

        </div>

    </div>

</div>
