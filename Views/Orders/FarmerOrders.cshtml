@model IEnumerable<DigitalAgriculturalMarketplace.Models.Order>
@{ ViewData["Title"] = "Orders"; }

<div class="management-shell">
    <partial name="_FarmerSidebar" />
    <div class="management-content">
        <div class="management-header"><div><h1>Orders</h1><p>Confirm new orders, track fulfilment, and review order history.</p></div></div>
        @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success" role="status">@TempData["SuccessMessage"]</div> }
        @if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div> }

        <form method="get" class="filter-panel compact-filter"><div class="d-flex flex-wrap align-items-end gap-2">
            <div><label class="form-label" for="farmerOrderStatus">Status</label><select id="farmerOrderStatus" name="status" class="form-select"><option value="">All orders</option><option value="Pending" selected="@(ViewBag.Status == "Pending")">Pending</option><option value="Confirmed" selected="@(ViewBag.Status == "Confirmed")">Confirmed</option><option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option><option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option></select></div>
            <button class="btn btn-primary btn-sm" type="submit">Apply</button><a asp-action="FarmerOrders" class="btn btn-secondary btn-sm">Clear</a>
        </div></form>

        @if (!Model.Any())
        {
            <div class="empty-state"><h2 class="h5">No orders found</h2><p class="mb-0">New orders or orders matching this filter will appear here.</p></div>
        }
        else
        {
            <div class="panel"><div class="panel-header"><div><h2>Order list</h2><p>@Model.Count() order(s)</p></div></div><div class="table-responsive border-0 rounded-0 shadow-none"><table class="table table-hover">
                <thead><tr><th>Order</th><th>Product</th><th>Customer</th><th>Total</th><th>Status</th><th>Placed</th><th></th></tr></thead>
                <tbody>@foreach (var order in Model) { <tr><td>#@order.Id</td><td><strong>@order.Product?.Name</strong><div class="product-meta">Qty @order.Quantity</div></td><td>@order.Consumer?.Name</td><td>Rs. @order.TotalPrice.ToString("N2")</td><td><partial name="_OrderStatus" model="order.Status" /></td><td>@order.OrderDate.ToString("dd MMM yyyy")</td><td><a class="btn btn-sm btn-secondary" asp-action="FarmerOrderDetails" asp-route-id="@order.Id">Manage</a></td></tr> }</tbody>
            </table></div></div>
        }
    </div>
</div>
