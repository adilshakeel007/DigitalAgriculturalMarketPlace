@model DigitalAgriculturalMarketplace.ViewModels.PlaceOrderViewModel

@{
    ViewData["Title"] = "Place Order";
}

<div class="container mt-4">

    <h2>Place Order</h2>

    <hr />


    <div class="row">
        <div class="col-12 col-md-8 col-lg-7">

            <h4>
                @Model.ProductName
            </h4>

            <p>
                <strong>Price Per Unit:</strong>
                Rs. @Model.PricePerUnit.ToString("N2")
            </p>

            <p>
                <strong>Available Quantity:</strong>
                @Model.AvailableQuantity
            </p>

            <form asp-controller="Orders"
                  asp-action="PlaceOrder"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="ProductId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="Quantity"
                           class="form-label">
                        Quantity
                    </label>

                    <input asp-for="Quantity"
                           class="form-control"
                           min="1"
                           max="@Model.AvailableQuantity" />

                    <span asp-validation-for="Quantity"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn btn-success">

                    Confirm Order

                </button>

                <a asp-controller="Marketplace"
                   asp-action="Details"
                   asp-route-id="@Model.ProductId"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
