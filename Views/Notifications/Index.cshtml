@model IEnumerable<DigitalAgriculturalMarketplace.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
    int unreadCount = Model.Count(n => !n.IsRead);
    bool showFarmerSidebar = Context.Session.GetString("UserType") == "Farmer";
}

<div class="@(showFarmerSidebar ? "management-shell" : "container")">
    @if (showFarmerSidebar) { <partial name="_FarmerSidebar" /> }
    <div class="@(showFarmerSidebar ? "management-content" : string.Empty)">
    <div class="page-header">
        <div><p class="eyebrow">Activity centre</p><h1 class="h2">Notifications</h1><p>@(unreadCount == 0 ? "You are all caught up." : $"You have {unreadCount} unread update(s).")</p></div>
        @if (unreadCount > 0)
        {
            <form asp-action="MarkAllAsRead" method="post"><button type="submit" class="btn btn-outline-primary">Mark all as read</button></form>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state"><h2 class="h4">Nothing new yet</h2><p class="mb-0">Order, message, and marketplace updates will appear here.</p></div>
    }
    else
    {
        <div class="d-grid gap-2">
            @foreach (var notification in Model)
            {
                <article class="card notification-item @(!notification.IsRead ? "unread" : string.Empty)">
                    <div class="card-body d-flex align-items-start justify-content-between gap-3">
                        <div>
                            <div class="d-flex align-items-center flex-wrap gap-2"><h2 class="h6 mb-0">@notification.Title</h2>@if (!notification.IsRead) { <span class="badge bg-success">New</span> }</div>
                            <p class="my-2">@notification.Message</p>
                            <small class="text-muted">@notification.CreatedAt.ToString("dd MMM yyyy, h:mm tt")</small>
                        </div>
                        @if (!notification.IsRead)
                        {
                            <form asp-action="MarkAsRead" method="post"><input type="hidden" name="id" value="@notification.Id" /><button type="submit" class="btn btn-sm btn-secondary text-nowrap">Mark read</button></form>
                        }
                    </div>
                </article>
            }
        </div>
    }
    </div>
</div>
