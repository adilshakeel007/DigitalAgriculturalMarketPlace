@model IEnumerable<DigitalAgriculturalMarketplace.Models.Message>
@{
    ViewData["Title"] = $"Conversation with {ViewBag.OtherUserName}";
    int currentUserId = Context.Session.GetInt32("UserId") ?? 0;
    bool showFarmerSidebar = Context.Session.GetString("UserType") == "Farmer";
}

<div class="@(showFarmerSidebar ? "management-shell" : "container")">
    @if (showFarmerSidebar) { <partial name="_FarmerSidebar" /> }
    <div class="@(showFarmerSidebar ? "management-content" : string.Empty)">
    <div class="page-header">
        <div><p class="eyebrow">Conversation</p><h1 class="h2">@ViewBag.OtherUserName</h1>@if (ViewBag.ProductName != null) { <p>Discussing @ViewBag.ProductName</p> }</div>
        <a asp-action="Inbox" class="btn btn-secondary">Back to messages</a>
    </div>

    @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success" role="status">@TempData["SuccessMessage"]</div> }

    <div class="card mb-3"><div class="card-body message-list">
        @if (!Model.Any())
        {
            <div class="empty-state"><h2 class="h5">Start the conversation</h2><p class="mb-0">Send a clear question or update below.</p></div>
        }
        else
        {
            @foreach (var message in Model)
            {
                bool sentByMe = message.SenderId == currentUserId;
                <article class="message-bubble @(sentByMe ? "sent" : string.Empty)">
                    <strong class="small">@(sentByMe ? "You" : message.Sender?.Name)</strong>
                    <p class="my-1">@message.Content</p>
                    <small class="text-muted">@message.SentAt.ToString("dd MMM yyyy, h:mm tt")</small>
                </article>
            }
        }
    </div></div>

    <div class="card"><div class="card-body">
        <form asp-action="Send" method="post">
            <input type="hidden" name="ReceiverId" value="@ViewBag.OtherUserId" />
            <input type="hidden" name="ProductId" value="@ViewBag.ProductId" />
            <label class="form-label" for="replyContent">Reply</label>
            <textarea id="replyContent" name="Content" class="form-control" rows="3" required maxlength="2000" placeholder="Write a helpful reply..." data-character-count></textarea>
            <div class="field-meta"><span>Keep messages clear and relevant to the order or product.</span><span data-character-output>0 / 2000</span></div>
            <div class="d-flex justify-content-end mt-3"><button type="submit" class="btn btn-primary">Send reply</button></div>
        </form>
    </div></div>
    </div>
</div>
