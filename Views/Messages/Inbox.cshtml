@model IEnumerable<DigitalAgriculturalMarketplace.ViewModels.InboxConversationViewModel>
@{ ViewData["Title"] = "Messages"; bool showFarmerSidebar = Context.Session.GetString("UserType") == "Farmer"; }

<div class="@(showFarmerSidebar ? "management-shell" : "container")">
    @if (showFarmerSidebar) { <partial name="_FarmerSidebar" /> }
    <div class="@(showFarmerSidebar ? "management-content" : string.Empty)">
    <div class="page-header"><div><p class="eyebrow">Conversations</p><h1 class="h2">Messages</h1><p>Questions and updates shared with marketplace members.</p></div></div>

    @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success" role="status">@TempData["SuccessMessage"]</div> }

    @if (!Model.Any())
    {
        <div class="empty-state"><h2 class="h4">No conversations yet</h2><p class="mb-0">Messages connected to products and orders will appear here.</p></div>
    }
    else
    {
        <div class="card overflow-hidden">
            <div class="list-group list-group-flush">
                @foreach (var conversation in Model)
                {
                    <a class="list-group-item list-group-item-action p-3" asp-action="Conversation" asp-route-userId="@conversation.OtherUserId" asp-route-productId="@conversation.ProductId">
                        <div class="d-flex align-items-start gap-3">
                            <span class="user-avatar flex-shrink-0" aria-hidden="true">@(conversation.OtherUserName.Substring(0, 1).ToUpperInvariant())</span>
                            <div class="flex-grow-1 min-width-0">
                                <div class="d-flex justify-content-between gap-3"><strong>@conversation.OtherUserName</strong><small class="text-muted text-nowrap">@conversation.LastMessageAt.ToString("dd MMM, h:mm tt")</small></div>
                                @if (!string.IsNullOrWhiteSpace(conversation.ProductName)) { <span class="product-meta">About @conversation.ProductName</span> }
                                <p class="text-truncate mb-0 mt-1">@conversation.LastMessage</p>
                            </div>
                            @if (conversation.UnreadCount > 0) { <span class="badge bg-success">@conversation.UnreadCount new</span> }
                        </div>
                    </a>
                }
            </div>
        </div>
    }
    </div>
</div>
