@{
    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    string Active(string targetController, string? targetAction = null) =>
        controller.Equals(targetController, StringComparison.OrdinalIgnoreCase) &&
        (targetAction == null || action.Equals(targetAction, StringComparison.OrdinalIgnoreCase))
            ? "active"
            : string.Empty;
}

<aside class="management-sidebar" aria-label="Selling workspace navigation">
    <div class="management-sidebar-heading">
        <span class="management-sidebar-label">Selling workspace</span>
        <strong>@Context.Session.GetString("UserName")</strong>
    </div>
    <nav class="management-nav">
        <a class="@Active("Home", "Dashboard")" asp-controller="Home" asp-action="Dashboard"><span>Dashboard</span></a>
        <a class="@Active("Products")" asp-controller="Products" asp-action="Index"><span>My listings</span></a>
        <a class="@Active("Orders")" asp-controller="Orders" asp-action="FarmerOrders"><span>My sales</span></a>
        <a class="@Active("Rfqs", "Browse")" asp-controller="Rfqs" asp-action="Browse"><span>Open RFQs</span></a>
        <a class="@Active("Rfqs", "MyQuotations")" asp-controller="Rfqs" asp-action="MyQuotations"><span>My quotations</span></a>
        <a class="@Active("SellerProfiles")" asp-controller="SellerProfiles" asp-action="Index"><span>Seller profile</span></a>
        <a class="@Active("Messages")" asp-controller="Messages" asp-action="Inbox"><span>Messages</span></a>
        <a class="@Active("Notifications")" asp-controller="Notifications" asp-action="Index"><span>Notifications</span></a>
    </nav>
</aside>
