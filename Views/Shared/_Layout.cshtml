<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DigitalAgriculturalMarketPlace</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DigitalAgriculturalMarketPlace.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @{
            string? currentUserType =
            Context.Session.GetString("UserType");
        }
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">DigitalAgriculturalMarketPlace</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @if (currentUserType == "Admin")
                        {
                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Admin"
                                   asp-action="Dashboard">

                                    Admin Dashboard

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Admin"
                                   asp-action="Users">

                                    Users

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Admin"
                                   asp-action="Products">

                                    Products

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Admin"
                                   asp-action="Orders">

                                    Orders

                                </a>

                            </li>
                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Admin"
                                   asp-action="Reports">

                                    Reports

                                </a>

                            </li>
                        }
                        @if (Context.Session.GetInt32("UserId") == null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Messages"
                                   asp-action="Inbox">
                                    Messages
                                </a>
                            </li>
                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Notifications"
                                   asp-action="Index">

                                    Notifications

                                </a>

                            </li>

                            <li class="nav-item">
                                <span class="nav-link text-dark">
                                    Hello, @Context.Session.GetString("UserName")
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-danger"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        }
                        @if (currentUserType == "Farmer")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Home"
                                   asp-action="FarmerDashboard">
                                    Farmer Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Products"
                                   asp-action="Index">
                                    My Products
                                </a>
                            </li>
                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Orders"
                                   asp-action="FarmerOrders">

                                    Orders

                                </a>

                            </li>
                        }

                        @if (currentUserType == "Consumer")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Home"
                                   asp-action="ConsumerDashboard">
                                    Consumer Dashboard
                                </a>
                            </li>
                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Marketplace"
                                   asp-action="Index">

                                    Marketplace

                                </a>

                            </li>
                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Orders"
                                   asp-action="MyOrders">

                                    My Orders

                                </a>

                            </li>
                            
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">

        <div class="container">

            &copy; @DateTime.Now.Year -
            Digital Agricultural Marketplace

        </div>

    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
