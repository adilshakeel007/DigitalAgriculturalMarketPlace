@{
    string? userType = Context.Session.GetString("UserType");
    string? userName = Context.Session.GetString("UserName");
    bool isSignedIn = Context.Session.GetInt32("UserId") != null;
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    string ActiveLink(string controller, string? action = null)
    {
        bool controllerMatches = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        bool actionMatches = action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return controllerMatches && actionMatches ? "active" : string.Empty;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="A trusted digital marketplace connecting local farmers and consumers." />
    <title>@ViewData["Title"] | AgriMarket</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
        <nav class="navbar navbar-expand-lg" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index" aria-label="AgriMarket home">
                    <span class="brand-mark" aria-hidden="true">A</span>
                    <span>Agri<span class="brand-accent">Market</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (!isSignedIn)
                        {
                            <li class="nav-item"><a class="nav-link @ActiveLink("Home", "Index")" asp-controller="Home" asp-action="Index">Home</a></li>
                        }
                        else if (userType == "Admin")
                        {
                            <li class="nav-item"><a class="nav-link @ActiveLink("Admin", "Dashboard")" asp-controller="Admin" asp-action="Dashboard">Overview</a></li>
                            <li class="nav-item"><a class="nav-link @ActiveLink("Admin", "Users")" asp-controller="Admin" asp-action="Users">Users</a></li>
                            <li class="nav-item"><a class="nav-link @ActiveLink("Admin", "Products")" asp-controller="Admin" asp-action="Products">Products</a></li>
                            <li class="nav-item"><a class="nav-link @ActiveLink("Admin", "Orders")" asp-controller="Admin" asp-action="Orders">Orders</a></li>
                            <li class="nav-item"><a class="nav-link @ActiveLink("Admin", "Reports")" asp-controller="Admin" asp-action="Reports">Reports</a></li>
                            <li class="nav-item"><a class="nav-link @ActiveLink("CatalogProducts")" asp-controller="CatalogProducts" asp-action="Moderation">Catalog</a></li>
                            <li class="nav-item"><a class="nav-link @ActiveLink("AdminRfqs")" asp-controller="AdminRfqs" asp-action="Index">RFQs</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @ActiveLink("Home", "Dashboard")" asp-controller="Home" asp-action="Dashboard">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @ActiveLink("Marketplace")" asp-controller="Marketplace" asp-action="Index">Marketplace</a></li>
                            <li class="nav-item"><a class="nav-link @ActiveLink("Products")" asp-controller="Products" asp-action="Index">My listings</a></li>
                            <li class="nav-item"><a class="nav-link @ActiveLink("Orders", "MyOrders")" asp-controller="Orders" asp-action="MyOrders">My purchases</a></li>
                            <li class="nav-item"><a class="nav-link @ActiveLink("Orders", "FarmerOrders")" asp-controller="Orders" asp-action="FarmerOrders">My sales</a></li>
                            <li class="nav-item"><a class="nav-link @ActiveLink("Rfqs", "Index")" asp-controller="Rfqs" asp-action="Index">My RFQs</a></li>
                        }
                    </ul>

                    <div class="navbar-actions">
                        @if (!isSignedIn)
                        {
                            <a class="btn btn-link nav-login" asp-controller="Account" asp-action="Login">Sign in</a>
                            <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Create account</a>
                        }
                        else
                        {
                            @if (userType != "Admin")
                            {
                                <a class="nav-utility @ActiveLink("Messages")" asp-controller="Messages" asp-action="Inbox">Messages</a>
                                <a class="nav-utility @ActiveLink("Notifications")" asp-controller="Notifications" asp-action="Index">Notifications</a>
                            }
                            <div class="dropdown">
                                <button class="user-menu dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="user-avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(userName) ? "U" : userName.Substring(0, 1).ToUpperInvariant())</span>
                                    <span class="user-details"><strong>@userName</strong><small>@userType</small></span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end">
                                    @if (userType != "Admin")
                                    {
                                        <a class="dropdown-item" asp-controller="SellerProfiles" asp-action="Index">Seller profile</a>
                                        <a class="dropdown-item" asp-controller="CatalogProducts" asp-action="Index">Catalog proposals</a>
                                        <a class="dropdown-item" asp-controller="Rfqs" asp-action="Browse">Open RFQs</a>
                                        <a class="dropdown-item" asp-controller="Rfqs" asp-action="MyQuotations">My quotations</a>
                                        <a class="dropdown-item" asp-controller="Home" asp-action="Profile">Account</a>
                                        <div class="dropdown-divider"></div>
                                    }
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button class="dropdown-item text-danger" type="submit">Sign out</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" class="page-shell" tabindex="-1">@RenderBody()</main>

    <footer class="site-footer">
        <div class="container footer-content">
            <div><a class="footer-brand" asp-controller="Home" asp-action="Index">AgriMarket</a><p>Fresh connections. Fair trade. Stronger communities.</p></div>
            <div class="footer-links"><a asp-controller="Home" asp-action="Privacy">Privacy</a><span>&copy; @DateTime.Now.Year AgriMarket</span></div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
