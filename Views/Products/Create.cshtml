@model DigitalAgriculturalMarketplace.ViewModels.ProductCreateViewModel
@{ ViewData["Title"] = "Add product"; }

<div class="management-shell">
    <partial name="_FarmerSidebar" />
    <div class="management-content">
        <div class="management-header"><div><h1>Add product</h1><p>Create a clear, accurate listing for marketplace customers.</p></div><a asp-action="Index" class="btn btn-secondary btn-sm">Back to products</a></div>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="order-detail-grid">
                <div class="panel"><div class="panel-body">
                    <section class="form-section">
                        <h2 class="form-section-title">Product information</h2>
                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label asp-for="CatalogProductId" class="form-label">Approved catalog product</label>
                                <select asp-for="CatalogProductId" class="form-select">
                                    <option value="">Select a catalog product</option>
                                    @foreach (var item in Model.CatalogProducts)
                                    {
                                        <option value="@item.Id">@item.Name — @item.Category</option>
                                    }
                                </select>
                                <span asp-validation-for="CatalogProductId" class="text-danger small"></span>
                                <div class="form-text"><a asp-controller="CatalogProducts" asp-action="Create">Propose a missing catalog product</a></div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="UnitOfMeasureId" class="form-label">Unit of measure</label>
                                <select asp-for="UnitOfMeasureId" class="form-select">
                                    <option value="">Select a unit</option>
                                    @foreach (var unit in Model.Units)
                                    {
                                        <option value="@unit.Id">@unit.Name (@unit.Code)</option>
                                    }
                                </select>
                                <span asp-validation-for="UnitOfMeasureId" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-7"><label asp-for="Name" class="form-label">Product name</label><input asp-for="Name" class="form-control" placeholder="e.g. Fresh tomatoes" autofocus /><span asp-validation-for="Name" class="text-danger small"></span></div>
                            <div class="col-md-5"><label asp-for="Category" class="form-label"></label><select asp-for="Category" class="form-select"><option value="">Choose category</option><option value="Vegetables">Vegetables</option><option value="Fruits">Fruits</option><option value="Grains">Grains</option><option value="Dairy">Dairy</option><option value="Other">Other</option></select><span asp-validation-for="Category" class="text-danger small"></span></div>
                            <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5" placeholder="Describe the product clearly without unsupported claims."></textarea><span asp-validation-for="Description" class="text-danger small"></span><div class="form-text">Maximum 1,000 characters.</div></div>
                        </div>
                    </section>
                    <section class="form-section">
                        <h2 class="form-section-title">Pricing and inventory</h2>
                        <div class="row g-3">
                            <div class="col-md-6"><label asp-for="PricePerUnit" class="form-label">Price per unit (Rs.)</label><input asp-for="PricePerUnit" class="form-control" min="0.01" step="0.01" /><span asp-validation-for="PricePerUnit" class="text-danger small"></span></div>
                            <div class="col-md-6"><label asp-for="Quantity" class="form-label">Available quantity</label><input asp-for="Quantity" class="form-control" min="0" step="1" /><span asp-validation-for="Quantity" class="text-danger small"></span><div class="form-text">Inventory decreases when an order is placed.</div></div>
                        </div>
                    </section>
                    <div class="d-flex flex-wrap gap-2 mt-4"><button type="submit" class="btn btn-primary">Save product</button><a asp-action="Index" class="btn btn-secondary">Cancel</a></div>
                </div></div>

                <aside class="panel"><div class="panel-body">
                    <h2 class="form-section-title">Product image</h2>
                    <div class="image-upload-preview mb-3" data-image-preview><div class="image-upload-placeholder"><span class="fallback-mark mx-auto mb-2">A</span><span>Image preview</span></div></div>
                    <label asp-for="ImageFile" class="form-label">Upload image</label>
                    <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" data-image-input data-preview-target="[data-image-preview]" />
                    <span asp-validation-for="ImageFile" class="text-danger small"></span>
                    <div class="form-text">JPG or PNG, up to 5 MB. Landscape images display best.</div>
                </div></aside>
            </div>
        </form>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
