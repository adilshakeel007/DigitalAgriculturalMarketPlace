@model IEnumerable<DigitalAgriculturalMarketplace.Models.Product>
@{ ViewData["Title"] = "Products"; }

<div class="management-shell">
    <partial name="_FarmerSidebar" />
    <div class="management-content">
        <div class="management-header"><div><h1>Products</h1><p>Manage listing details, pricing, availability, and stock.</p></div><a asp-action="Create" class="btn btn-primary btn-sm">Add product</a></div>
        @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success" role="status">@TempData["SuccessMessage"]</div> }

        @if (!Model.Any())
        {
            <div class="empty-state"><h2 class="h5">Start your catalogue</h2><p>Add your first product so consumers can discover it.</p><a asp-action="Create" class="btn btn-primary btn-sm">Add first product</a></div>
        }
        else
        {
            <div class="panel">
                <div class="panel-header"><div><h2>All products</h2><p>@Model.Count() listing(s)</p></div><span class="product-meta">@Model.Count(p => p.IsActive) active</span></div>
                <div class="table-responsive border-0 rounded-0 shadow-none"><table class="table table-hover">
                    <thead><tr><th>Product</th><th>Price</th><th>Inventory</th><th>Visibility</th><th>Updated</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                    <tbody>
                    @foreach (var product in Model)
                    {
                        string stockClass = product.Quantity == 0 ? "out" : product.Quantity <= 5 ? "low" : string.Empty;
                        string stockText = product.Quantity == 0 ? "Out of stock" : product.Quantity <= 5 ? $"Low stock · {product.Quantity}" : $"{product.Quantity} in stock";
                        <tr>
                            <td><div class="d-flex align-items-center gap-3">@if (!string.IsNullOrEmpty(product.ImageUrl)) { <img class="table-thumbnail" src="@product.ImageUrl" alt="" loading="lazy" /> } else { <span class="table-thumbnail product-image-placeholder" aria-hidden="true">A</span> }<div><strong>@product.Name</strong><div class="product-meta">@product.Category</div></div></div></td>
                            <td><strong>Rs. @product.PricePerUnit.ToString("N2")</strong><div class="product-meta">per unit</div></td>
                            <td><span class="stock-label @stockClass">@stockText</span></td>
                            <td><span class="status-pill @(product.IsActive ? "status-completed" : "status-neutral")"><span class="status-dot"></span>@(product.IsActive ? "Active" : "Hidden")</span></td>
                            <td>@product.ListedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-nowrap"><a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-secondary">Edit</a><a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-link">View</a><a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-link text-danger">Remove</a></td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            </div>
        }
    </div>
</div>
