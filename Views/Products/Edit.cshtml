@model DigitalAgriculturalMarketplace.ViewModels.ProductEditViewModel
@{ ViewData["Title"] = "Edit product"; }

<div class="management-shell">
    <partial name="_FarmerSidebar" />
    <div class="management-content">
        <div class="management-header"><div><h1>Edit product</h1><p>Update @Model.Name without changing its order history.</p></div><a asp-action="Index" class="btn btn-secondary btn-sm">Back to products</a></div>
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="CurrentImageUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="order-detail-grid">
                <div class="panel"><div class="panel-body">
                    <section class="form-section"><h2 class="form-section-title">Product information</h2><div class="row g-3">
                        <div class="col-md-7"><label asp-for="Name" class="form-label">Product name</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
                        <div class="col-md-5"><label asp-for="Category" class="form-label"></label><select asp-for="Category" class="form-select"><option>Vegetables</option><option>Fruits</option><option>Grains</option><option>Dairy</option><option>Other</option></select><span asp-validation-for="Category" class="text-danger small"></span></div>
                        <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5"></textarea><span asp-validation-for="Description" class="text-danger small"></span></div>
                    </div></section>
                    <section class="form-section"><h2 class="form-section-title">Pricing</h2><div class="row g-3">
                        <div class="col-md-6"><label asp-for="PricePerUnit" class="form-label">Price per unit (Rs.)</label><input asp-for="PricePerUnit" class="form-control" min="0.01" step="0.01" /><span asp-validation-for="PricePerUnit" class="text-danger small"></span></div>
                        <div class="col-12"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Visible in the marketplace</label></div><div class="form-text">Hidden products remain in order history but cannot receive new orders.</div></div>
                    </div></section>
                    <div class="d-flex flex-wrap gap-2 mt-4"><button type="submit" class="btn btn-primary">Save changes</button><a asp-action="Index" class="btn btn-secondary">Cancel</a></div>
                </div></div>

                <aside class="panel"><div class="panel-body">
                    <h2 class="form-section-title">Product image</h2>
                    <div class="image-upload-preview mb-3" data-image-preview>
                        @if (!string.IsNullOrEmpty(Model.CurrentImageUrl)) { <img src="@Model.CurrentImageUrl" alt="Current image for @Model.Name" /> }
                        else { <div class="image-upload-placeholder"><span class="fallback-mark mx-auto mb-2">A</span><span>No image uploaded</span></div> }
                    </div>
                    <label asp-for="NewImageFile" class="form-label">@(string.IsNullOrEmpty(Model.CurrentImageUrl) ? "Add image" : "Replace image")</label>
                    <input asp-for="NewImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" data-image-input data-preview-target="[data-image-preview]" />
                    <span asp-validation-for="NewImageFile" class="text-danger small"></span><div class="form-text">JPG or PNG, up to 5 MB. Leave empty to keep the current image.</div>
                </div></aside>
            </div>
        </form>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
