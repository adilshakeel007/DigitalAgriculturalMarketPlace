@model DigitalAgriculturalMarketplace.ViewModels.ProductEditViewModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-12 col-md-8 col-lg-7">

            <div class="card shadow">

                <div class="card-body">

                    <h2 class="mb-4">
                        Edit Product
                    </h2>

                    <form asp-action="Edit"
                          method="post"
                          enctype="multipart/form-data">

                        <input type="hidden"
                               asp-for="Id" />
                        @if (!string.IsNullOrEmpty(Model.CurrentImageUrl))
                        {
                            <div class="mb-3">

                                <label class="form-label">
                                    Current Image
                                </label>
                                <div class="mb-3">

                                    <label asp-for="NewImageFile"
                                           class="form-label">
                                        Replace Image
                                    </label>

                                    <input asp-for="NewImageFile"
                                           type="file"
                                           class="form-control"
                                           accept=".jpg,.jpeg,.png" />

                                    <span asp-validation-for="NewImageFile"
                                          class="text-danger">
                                    </span>

                                    <small class="text-muted">
                                        Leave empty to keep the current image.
                                    </small>

                                </div>

                                <br />

                                <img src="@Model.CurrentImageUrl"
                                     alt="@Model.Name"
                                     width="150"
                                     height="150"
                                     style="object-fit: cover;" />

                            </div>
                        }


                        <div asp-validation-summary="ModelOnly"
                             class="text-danger">
                        </div>


                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label">
                                Product Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Category"
                                   class="form-label">
                                Category
                            </label>

                            <select asp-for="Category"
                                    class="form-select">

                                <option value="Vegetables">
                                    Vegetables
                                </option>

                                <option value="Fruits">
                                    Fruits
                                </option>

                                <option value="Grains">
                                    Grains
                                </option>

                                <option value="Dairy">
                                    Dairy
                                </option>

                                <option value="Other">
                                    Other
                                </option>

                            </select>

                        </div>


                        <div class="mb-3">

                            <label asp-for="PricePerUnit"
                                   class="form-label">
                                Price Per Unit
                            </label>

                            <input asp-for="PricePerUnit"
                                   class="form-control" />

                            <span asp-validation-for="PricePerUnit"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Quantity"
                                   class="form-label">
                                Available Quantity
                            </label>

                            <input asp-for="Quantity"
                                   class="form-control" />

                            <span asp-validation-for="Quantity"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4">
                            </textarea>

                        </div>


                        <div class="form-check mb-3">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label">

                                Active Product

                            </label>

                        </div>


                        <button type="submit"
                                class="btn btn-warning">

                            Update Product

                        </button>


                        <a asp-action="Index"
                           class="btn btn-secondary">

                            Cancel

                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
