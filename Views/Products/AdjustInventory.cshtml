@model DigitalAgriculturalMarketplace.ViewModels.InventoryAdjustmentViewModel
@using DigitalAgriculturalMarketplace.Models
@{ ViewData["Title"]="Adjust inventory"; var movements=ViewBag.Movements as IEnumerable<InventoryMovement> ?? []; }
<div class="management-shell"><partial name="_FarmerSidebar"/><main class="management-content">
<div class="management-header"><div><p class="eyebrow">Inventory</p><h1>Adjust @Model.ProductName</h1><p>Stock changes are recorded permanently in the inventory ledger.</p></div><a asp-action="Index" class="btn btn-secondary btn-sm">Back</a></div>
<div class="order-detail-grid"><section class="panel"><div class="panel-body"><div class="row g-3 mb-4"><div class="col"><span class="product-meta">Available</span><div class="h4">@Model.CurrentAvailable.ToString("0.###")</div></div><div class="col"><span class="product-meta">Reserved</span><div class="h4">@Model.Reserved.ToString("0.###")</div></div><div class="col"><span class="product-meta">On hand</span><div class="h4">@((Model.CurrentAvailable+Model.Reserved).ToString("0.###"))</div></div></div>
<form method="post"><input type="hidden" asp-for="ProductId"/><input type="hidden" asp-for="ProductName"/><input type="hidden" asp-for="CurrentAvailable"/><input type="hidden" asp-for="Reserved"/><input type="hidden" asp-for="OperationKey"/><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="mb-3"><label asp-for="NewAvailable" class="form-label">New available quantity</label><input asp-for="NewAvailable" class="form-control" step="0.001" min="0"/><span asp-validation-for="NewAvailable" class="text-danger"></span></div><div class="mb-3"><label asp-for="Reason" class="form-label">Reason</label><textarea asp-for="Reason" class="form-control" rows="3"></textarea><span asp-validation-for="Reason" class="text-danger"></span></div><button class="btn btn-primary">Record adjustment</button></form></div></section>
<aside class="panel"><div class="panel-header"><h2>Recent movements</h2></div><div class="panel-body">@if(!movements.Any()){<p class="text-muted">No movements recorded.</p>}else{<div class="d-grid gap-3">@foreach(var m in movements){<div><strong>@m.MovementType</strong><div class="product-meta">Available @m.AvailableDelta.ToString("+0.###;-0.###;0") · Reserved @m.ReservedDelta.ToString("+0.###;-0.###;0")</div><small class="text-muted">@m.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</small></div>}</div>}</div></aside></div></main></div>
@section Scripts{@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}}
