@{ ViewData["Title"] = "Privacy"; }

<div class="container">
    <div class="page-header"><div><p class="eyebrow">Your information</p><h1 class="h2">Privacy</h1><p>How information is used within this marketplace.</p></div></div>
    <div class="card"><div class="card-body p-4 p-lg-5">
        <h2 class="h5">Account information</h2>
        <p>AgriMarket uses the name, email address, phone number, and account type you provide to operate your account and support marketplace transactions.</p>
        <h2 class="h5 mt-4">Marketplace activity</h2>
        <p>Product listings, orders, messages, reviews, and notifications are stored so the platform can provide its core farmer, consumer, and administrative workflows.</p>
        <h2 class="h5 mt-4">Session security</h2>
        <p class="mb-0">A secure, HTTP-only session cookie keeps you signed in. Always sign out when using a shared device.</p>
    </div></div>
</div>
