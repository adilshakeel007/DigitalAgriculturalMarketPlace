@model DigitalAgriculturalMarketplace.ViewModels.ConsumerDashboardViewModel

@{
    ViewData["Title"] = "Consumer Dashboard";
}

<div class="container mt-4">

    <div class="mb-4">

        <h2>
            Consumer Dashboard
        </h2>

        <p class="text-muted">
            Welcome,
            @Context.Session.GetString("UserName")
        </p>

    </div>


    <!-- ORDER SUMMARY -->

    <div class="row">

        <div class="col-12 col-md-4 mb-3">

            <div class="card shadow-sm dashboard-card">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Orders
                    </h6>

                    <h3>
                        @Model.TotalOrders
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-12 col-md-4 mb-3">

            <div class="card shadow-sm dashboard-card">

                <div class="card-body">

                    <h6 class="text-muted">
                        Pending Orders
                    </h6>

                    <h3>
                        @Model.PendingOrders
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-12 col-md-4 mb-3">

            <div class="card shadow-sm dashboard-card">

                <div class="card-body">

                    <h6 class="text-muted">
                        Confirmed Orders
                    </h6>

                    <h3>
                        @Model.ConfirmedOrders
                    </h3>

                </div>

            </div>

        </div>

    </div>


    <div class="row">

        <div class="col-12 col-md-4 mb-3">

            <div class="card shadow-sm dashboard-card">

                <div class="card-body">

                    <h6 class="text-muted">
                        Completed Orders
                    </h6>

                    <h3>
                        @Model.CompletedOrders
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-4 mb-3">

            <div class="card shadow-sm dashboard-card">

                <div class="card-body">

                    <h6 class="text-muted">
                        Cancelled Orders
                    </h6>

                    <h3>
                        @Model.CancelledOrders
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-12 col-md-4 mb-3">

            <div class="card shadow-sm dashboard-card">

                <div class="card-body">

                    <h6 class="text-muted">
                        Unread Messages
                    </h6>

                    <h3>
                        @Model.UnreadMessages
                    </h3>

                </div>

            </div>

        </div>

    </div>
    <div class="col-12 col-md-4 mb-3">

        <div class="card shadow-sm dashboard-card">

            <div class="card-body">

                <h6 class="text-muted">
                    Unread Notifications
                </h6>

                <h3>
                    @Model.UnreadNotifications
                </h3>

                <a asp-controller="Notifications"
                   asp-action="Index">

                    View Notifications

                </a>

            </div>

        </div>

    </div>


    <hr class="my-4" />


    <!-- QUICK ACTIONS -->

    <h4>
        Quick Actions
    </h4>

    <div class="mb-4">

        <a asp-controller="Marketplace"
           asp-action="Index"
           class="btn btn-primary me-2">

            Browse Marketplace

        </a>

        <a asp-controller="Orders"
           asp-action="MyOrders"
           class="btn btn-success me-2">

            My Orders

        </a>

        <a asp-controller="Messages"
           asp-action="Inbox"
           class="btn btn-secondary">

            Messages

        </a>

    </div>


    <hr class="my-4" />


    <!-- RECENT ORDERS -->

    <div class="d-flex
                justify-content-between
                align-items-center">

        <h4>
            Recent Orders
        </h4>

        <a asp-controller="Orders"
           asp-action="MyOrders">

            View All Orders

        </a>

    </div>


    @if (!Model.RecentOrders.Any())
    {
        <div class="alert alert-info mt-3">

            You have not placed any orders yet.

            <br />

            <a asp-controller="Marketplace"
               asp-action="Index">

                Browse Marketplace

            </a>

        </div>
    }
    else
    {
        <div class="table-responsive mt-3">

            <table class="table table-bordered table-hover">

                <thead>

                    <tr>

                        <th>
                            Order ID
                        </th>

                        <th>
                            Product
                        </th>

                        <th>
                            Farmer
                        </th>

                        <th>
                            Quantity
                        </th>

                        <th>
                            Total
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (
                                    var order in Model.RecentOrders)
                    {
                        <tr>

                            <td>
                                @order.Id
                            </td>

                            <td>
                                @order.Product?.Name
                            </td>

                            <td>
                                @order.Product?.Farmer?.Name
                            </td>

                            <td>
                                @order.Quantity
                            </td>

                            <td>
                                Rs.
                                @order.TotalPrice.ToString("N2")
                            </td>

                            <td>

                                @if (
                                                        order.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">

                                        Pending

                                    </span>
                                }

                                else if (
                                order.Status == "Confirmed")
                                {
                                    <span class="badge bg-primary">

                                        Confirmed

                                    </span>
                                }

                                else if (
                                order.Status == "Completed")
                                {
                                    <span class="badge bg-success">

                                        Completed

                                    </span>
                                }

                                else if (
                                order.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">

                                        Cancelled

                                    </span>
                                }

                        </td>

                        <td>
                            @(order.OrderDate
                                                    .ToString("dd MMM yyyy"))
                    </td>

                            <td>

                                <a asp-controller="Orders"
                                   asp-action="ConsumerOrderDetails"
                                   asp-route-id="@order.Id"
                                   class="btn btn-sm btn-primary">

                                    View

                                </a>

                            </td>

                        </tr>
                                }

                </tbody>

            </table>

        </div>
    }

</div>