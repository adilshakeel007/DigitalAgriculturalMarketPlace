@model DigitalAgriculturalMarketplace.ViewModels.FarmerDashboardViewModel
@{ ViewData["Title"] = "Farmer overview"; }

<div class="management-shell">
    <partial name="_FarmerSidebar" />

    <div class="management-content">
        <div class="management-header">
            <div><h1>Overview</h1><p>Manage today’s orders and keep inventory ready for customers.</p></div>
            <a class="btn btn-primary btn-sm" asp-controller="Products" asp-action="Create">Add product</a>
        </div>

        @if (Model.LowStockProducts > 0)
        {
            <div class="alert alert-warning d-flex align-items-center justify-content-between gap-3" role="alert">
                <span><strong>@Model.LowStockProducts product(s)</strong> have five or fewer units remaining.</span>
                <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-warning">Review inventory</a>
            </div>
        }

        <div class="management-kpis">
            <div class="compact-kpi"><span class="compact-kpi-label">Pending orders</span><span class="compact-kpi-value">@Model.PendingOrders</span><span class="compact-kpi-meta">Need your attention</span></div>
            <div class="compact-kpi"><span class="compact-kpi-label">Confirmed orders</span><span class="compact-kpi-value">@Model.ConfirmedOrders</span><span class="compact-kpi-meta">Ready to fulfil</span></div>
            <div class="compact-kpi"><span class="compact-kpi-label">Active products</span><span class="compact-kpi-value">@Model.ActiveProducts</span><span class="compact-kpi-meta">of @Model.TotalProducts total</span></div>
            <div class="compact-kpi"><span class="compact-kpi-label">Completed revenue</span><span class="compact-kpi-value">Rs. @Model.TotalRevenue.ToString("N0")</span><span class="compact-kpi-meta">From completed orders</span></div>
        </div>

        <div class="workspace-grid">
            <section class="panel" aria-labelledby="recentOrdersTitle">
                <div class="panel-header"><div><h2 id="recentOrdersTitle">Recent orders</h2><p>Latest customer activity</p></div><a class="panel-link" asp-controller="Orders" asp-action="FarmerOrders">View all</a></div>
                @if (!Model.RecentOrders.Any())
                {
                    <div class="panel-body"><div class="empty-state"><h3 class="h6">No orders yet</h3><p class="mb-0">Customer orders will appear here.</p></div></div>
                }
                else
                {
                    <div class="table-responsive border-0 rounded-0 shadow-none"><table class="table table-hover">
                        <thead><tr><th>Order</th><th>Product</th><th>Customer</th><th>Total</th><th>Status</th><th></th></tr></thead>
                        <tbody>@foreach (var order in Model.RecentOrders) { <tr><td>#@order.Id</td><td><strong>@order.Product?.Name</strong><div class="product-meta">Qty @order.Quantity</div></td><td>@order.Consumer?.Name</td><td>Rs. @order.TotalPrice.ToString("N2")</td><td><partial name="_OrderStatus" model="order.Status" /></td><td><a class="btn btn-sm btn-secondary" asp-controller="Orders" asp-action="FarmerOrderDetails" asp-route-id="@order.Id">Manage</a></td></tr> }</tbody>
                    </table></div>
                }
            </section>

            <div class="d-grid gap-3">
                <section class="panel" aria-labelledby="inventoryTitle">
                    <div class="panel-header"><div><h2 id="inventoryTitle">Inventory</h2><p>@Model.TotalStockUnits active units listed</p></div><a class="panel-link" asp-controller="Products" asp-action="Index">Manage</a></div>
                    <div class="panel-body pt-0 pb-0">
                        @if (!Model.InventoryOverview.Any()) { <p class="text-muted small py-3 mb-0">No products added yet.</p> }
                        @foreach (var product in Model.InventoryOverview)
                        {
                            string stockClass = product.Quantity == 0 ? "out" : product.Quantity <= 5 ? "low" : string.Empty;
                            <div class="inventory-row"><div><strong>@product.Name</strong><small>@product.Category · @(product.IsActive ? "Active" : "Inactive")</small></div><span class="stock-value @stockClass">@(product.Quantity == 0 ? "Out of stock" : $"{product.Quantity} units")</span></div>
                        }
                    </div>
                </section>

                <section class="panel" aria-labelledby="quickActionsTitle">
                    <div class="panel-header"><h2 id="quickActionsTitle">Quick actions</h2></div>
                    <div class="panel-body management-actions">
                        <a class="management-action" asp-controller="Products" asp-action="Create"><span>Add a product</span><span aria-hidden="true">&rarr;</span></a>
                        <a class="management-action" asp-controller="Orders" asp-action="FarmerOrders"><span>Process orders</span><span aria-hidden="true">&rarr;</span></a>
                        <a class="management-action" asp-controller="Messages" asp-action="Inbox"><span>Messages (@Model.UnreadMessages)</span><span aria-hidden="true">&rarr;</span></a>
                        <a class="management-action" asp-controller="Notifications" asp-action="Index"><span>Notifications (@Model.UnreadNotifications)</span><span aria-hidden="true">&rarr;</span></a>
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>
