@model IEnumerable<DigitalAgriculturalMarketplace.Models.Product>
@{ ViewData["Title"] = "Marketplace"; }

<div class="container">
    <div class="page-header">
        <div>
            <p class="eyebrow">Local marketplace</p>
            <h1 class="h2">Find fresh products</h1>
            <p>Browse active listings from registered farmers.</p>
        </div>
        <span class="badge bg-success align-self-center">@Model.Count() available</span>
    </div>

    <form asp-controller="Marketplace" asp-action="Index" method="get" class="filter-panel compact-filter">
        <div class="row g-3 align-items-end">
            <div class="col-lg-4">
                <label class="form-label" for="searchTerm">Search</label>
                <input id="searchTerm" type="search" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Product, category, or description" />
            </div>
            <div class="col-sm-6 col-lg-2">
                <label class="form-label" for="category">Category</label>
                <select id="category" name="category" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Category))">All categories</option>
                    <option value="Vegetables" selected="@(ViewBag.Category == "Vegetables")">Vegetables</option>
                    <option value="Fruits" selected="@(ViewBag.Category == "Fruits")">Fruits</option>
                    <option value="Grains" selected="@(ViewBag.Category == "Grains")">Grains</option>
                    <option value="Dairy" selected="@(ViewBag.Category == "Dairy")">Dairy</option>
                    <option value="Other" selected="@(ViewBag.Category == "Other")">Other</option>
                </select>
            </div>
            <div class="col-sm-6 col-lg-2">
                <label class="form-label" for="sortBy">Sort</label>
                <select id="sortBy" name="sortBy" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.SortBy))">Newest</option>
                    <option value="price_low" selected="@(ViewBag.SortBy == "price_low")">Price: low to high</option>
                    <option value="price_high" selected="@(ViewBag.SortBy == "price_high")">Price: high to low</option>
                    <option value="oldest" selected="@(ViewBag.SortBy == "oldest")">Oldest</option>
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label" for="minPrice">Min price</label>
                <input id="minPrice" type="number" name="minPrice" value="@ViewBag.MinPrice" class="form-control" min="0" step="0.01" placeholder="0" />
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label" for="maxPrice">Max price</label>
                <input id="maxPrice" type="number" name="maxPrice" value="@ViewBag.MaxPrice" class="form-control" min="0" step="0.01" placeholder="Any" />
            </div>
            <div class="col-12 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Apply filters</button>
                <a asp-action="Index" class="btn btn-secondary">Clear</a>
            </div>
        </div>
    </form>

    @if (ViewBag.PriceError != null)
    {
        <div class="alert alert-danger" role="alert">@ViewBag.PriceError</div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">
            <h2 class="h4">No products match those filters</h2>
            <p>Try a broader search or clear the price range.</p>
            <a asp-action="Index" class="btn btn-primary">Show all products</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var product in Model)
            {
                <div class="col-sm-6 col-xl-3">
                    <article class="card product-card">
                        <partial name="_ProductImage" model="product" />
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between gap-2 mb-2">
                                <span class="product-meta">@product.Category</span>
                                @if (product.Quantity <= 5)
                                {
                                    <span class="stock-label low">@product.Quantity left</span>
                                }
                                else
                                {
                                    <span class="stock-label">@product.Quantity available</span>
                                }
                            </div>
                            <h2 class="card-title h5">@product.Name</h2>
                            <p class="product-meta mb-3">Sold by @product.Farmer?.Name</p>
                            <div class="d-flex align-items-center justify-content-between gap-2 mt-auto">
                                <span class="price-line"><span class="product-price">Rs. @product.PricePerUnit.ToString("N2")</span><span class="price-unit">/ unit</span></span>
                                <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary" aria-label="View @product.Name">View product</a>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>
