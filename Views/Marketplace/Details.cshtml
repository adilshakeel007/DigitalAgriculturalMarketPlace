@model DigitalAgriculturalMarketplace.Models.Product
@{
    ViewData["Title"] = Model.Name;
    double averageRating = Model.Reviews.Any() ? Model.Reviews.Average(r => r.Rating) : 0;
}

<div class="container">
    <nav class="mb-3" aria-label="Breadcrumb"><a asp-action="Index">Marketplace</a> <span class="text-muted">/ @Model.Name</span></nav>

    <div class="row g-4 g-lg-5">
        <div class="col-lg-6 product-gallery">
            <partial name="_ProductImage" model="Model" />
        </div>

        <div class="col-lg-6">
            <p class="eyebrow">@Model.Category</p>
            <h1 class="h2">@Model.Name</h1>
            <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                <span class="price-line"><span class="product-price">Rs. @Model.PricePerUnit.ToString("N2")</span><span class="price-unit">per unit</span></span>
                @{ var available = Model.AvailableQuantity ?? Model.Quantity; var unit = Model.UnitOfMeasure?.Code ?? "unit"; }
                <span class="stock-label @(available <= 5 ? "low" : string.Empty)">@available.ToString("0.###") @unit available</span>
            </div>

            <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "The farmer has not added a description for this product yet." : Model.Description)</p>

            <dl class="detail-list my-4">
                <dt>Farmer</dt><dd>@Model.Farmer?.Name</dd>
                <dt>Listed</dt><dd>@Model.ListedAt.ToString("dd MMM yyyy")</dd>
                <dt>Customer rating</dt>
                <dd>@(Model.Reviews.Any() ? $"{averageRating:0.0} / 5 from {Model.Reviews.Count} review(s)" : "No reviews yet")</dd>
            </dl>

            <div class="d-flex flex-wrap gap-2 mb-4">
                <a asp-controller="Orders" asp-action="PlaceOrder" asp-route-productId="@Model.Id" class="btn btn-primary">Place order</a>
                @if (Model.Farmer != null)
                {
                    <a asp-controller="Messages" asp-action="Send" asp-route-receiverId="@Model.Farmer.Id" asp-route-productId="@Model.Id" class="btn btn-outline-primary">Message farmer</a>
                }
            </div>

            <div class="card"><div class="card-body"><h2 class="h5">Buy with confidence</h2><p class="mb-0">Your order begins as pending. The farmer confirms it, completes fulfilment, and you can review the product after completion.</p></div></div>
        </div>
    </div>

    <section class="mt-5" aria-labelledby="reviewsTitle">
        <div class="page-header mb-3"><div><p class="eyebrow">Verified feedback</p><h2 id="reviewsTitle" class="h4">Customer reviews</h2></div></div>
        @if (!Model.Reviews.Any())
        {
            <div class="empty-state"><h3>No reviews yet</h3><p class="mb-0">Completed-order reviews will appear here.</p></div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var review in Model.Reviews.OrderByDescending(r => r.ReviewDate))
                {
                    <div class="col-md-6"><article class="card h-100"><div class="card-body">
                        <div class="d-flex justify-content-between gap-2"><strong>@review.Consumer?.Name</strong><span class="badge bg-warning">@review.Rating / 5</span></div>
                        @if (!string.IsNullOrWhiteSpace(review.Comment)) { <p class="my-3">@review.Comment</p> }
                        <small class="text-muted">@review.ReviewDate.ToString("dd MMM yyyy")</small>
                    </div></article></div>
                }
            </div>
        }
    </section>
</div>
