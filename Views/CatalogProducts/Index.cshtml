@model IEnumerable<DigitalAgriculturalMarketplace.Models.CatalogProduct>
@{ ViewData["Title"] = "Catalog proposals"; }
<div class="container"><div class="page-header"><div><p class="eyebrow">Selling</p><h1 class="h2">Catalog proposals</h1><p>Track agricultural products you have proposed for the shared catalog.</p></div><a class="btn btn-primary" asp-action="Create">New proposal</a></div><div class="panel"><div class="panel-body p-0">@if (!Model.Any()) { <div class="empty-state"><p>No proposals submitted.</p></div> } else { <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Product</th><th>Category</th><th>Unit</th><th>Status</th><th>Submitted</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><strong>@item.Name</strong>@if (!string.IsNullOrWhiteSpace(item.ReviewNotes)) { <div class="product-meta">@item.ReviewNotes</div> }</td><td>@item.Category</td><td>@item.DefaultUnit?.Name</td><td><span class="status-pill @(item.Status == "Approved" ? "status-completed" : item.Status == "Rejected" ? "status-cancelled" : "status-pending")">@item.Status</span></td><td>@(item.SubmittedAt ?? item.CreatedAt).ToString("dd MMM yyyy")</td></tr> }</tbody></table></div> }</div></div></div>
