@model DigitalAgriculturalMarketplace.ViewModels.CatalogProductProposalViewModel
@{ ViewData["Title"] = "Propose catalog product"; }
<div class="container checkout-container"><div class="page-header"><div><p class="eyebrow">Shared catalog</p><h1 class="h2">Propose a product</h1><p>Submit a clear product definition for administrator review.</p></div><a class="btn btn-secondary" asp-action="Index">Back</a></div><div class="panel"><div class="panel-body"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-3"><div class="col-md-7"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div><div class="col-md-5"><label asp-for="Category" class="form-label"></label><input asp-for="Category" class="form-control" /><span asp-validation-for="Category" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="DefaultUnitId" class="form-label">Default unit</label><select asp-for="DefaultUnitId" class="form-select"><option value="">Select unit</option>@foreach (var unit in Model.Units) { <option value="@unit.Id">@unit.Name (@unit.Code)</option> }</select><span asp-validation-for="DefaultUnitId" class="text-danger small"></span></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5"></textarea><span asp-validation-for="Description" class="text-danger small"></span></div></div><button class="btn btn-primary mt-4" type="submit">Submit proposal</button></form></div></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
