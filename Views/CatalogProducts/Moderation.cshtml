@model IEnumerable<DigitalAgriculturalMarketplace.Models.CatalogProduct>
@{ ViewData["Title"] = "Catalog moderation"; }
<div class="container"><div class="page-header"><div><p class="eyebrow">Administration</p><h1 class="h2">Catalog moderation</h1><p>Approve or reject seller-proposed catalog products.</p></div></div><form method="get" class="filter-panel compact-filter mb-3"><div class="d-flex gap-2 align-items-end"><div><label class="form-label">Status</label><select name="status" class="form-select"><option value="">All</option><option value="Pending" selected="@(ViewBag.Status == "Pending")">Pending</option><option value="Approved" selected="@(ViewBag.Status == "Approved")">Approved</option><option value="Rejected" selected="@(ViewBag.Status == "Rejected")">Rejected</option></select></div><button class="btn btn-primary" type="submit">Apply</button></div></form><div class="panel"><div class="panel-body p-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Proposal</th><th>Seller</th><th>Unit</th><th>Status</th><th>Review</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><strong>@item.Name</strong><div class="product-meta">@item.Category</div></td><td>@item.SubmittedByUser?.Name</td><td>@item.DefaultUnit?.Name</td><td><span class="status-pill @(item.Status == "Approved" ? "status-completed" : item.Status == "Rejected" ? "status-cancelled" : "status-pending")">@item.Status</span></td><td>@if (item.Status == "Pending") { <form asp-action="Moderate" method="post"><input type="hidden" name="Id" value="@item.Id" /><input type="hidden" name="RowVersion" value="@Convert.ToBase64String(item.RowVersion)" /><input class="form-control form-control-sm mb-2" name="ReviewNotes" maxlength="1000" placeholder="Optional review note" /><div class="d-flex gap-2"><button class="btn btn-sm btn-success" name="decision" value="Approved" type="submit">Approve</button><button class="btn btn-sm btn-danger" name="decision" value="Rejected" type="submit">Reject</button></div></form> } else { <span class="product-meta">@item.ReviewedByUser?.Name<br />@item.ReviewedAt?.ToString("dd MMM yyyy")</span> }</td></tr> }</tbody></table></div></div></div></div>
