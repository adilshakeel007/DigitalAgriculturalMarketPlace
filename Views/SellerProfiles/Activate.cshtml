@model DigitalAgriculturalMarketplace.ViewModels.SellerProfileViewModel
@{ ViewData["Title"] = "Start selling"; }
<div class="container checkout-container"><div class="page-header"><div><p class="eyebrow">Seller profile</p><h1 class="h2">Start selling</h1><p>Activate selling without changing your ability to buy.</p></div></div><div class="panel"><div class="panel-body"><form asp-action="Activate" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="mb-3"><label asp-for="DisplayName" class="form-label"></label><input asp-for="DisplayName" class="form-control" /><span asp-validation-for="DisplayName" class="text-danger small"></span></div><div class="mb-4"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5"></textarea><span asp-validation-for="Description" class="text-danger small"></span></div><button class="btn btn-primary" type="submit">Activate seller profile</button></form></div></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
