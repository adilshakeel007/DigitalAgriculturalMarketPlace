@model DigitalAgriculturalMarketplace.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Create account"; }

<div class="auth-shell">
    <section class="auth-intro">
        <p class="eyebrow text-white">Join AgriMarket</p>
        <h1 class="h2">One marketplace, built for both sides of local agriculture.</h1>
        <p>Choose the account that fits you. Farmers can list and manage produce; consumers can discover, order, message, and review.</p>
    </section>

    <section class="auth-panel">
        <div class="auth-card">
            <p class="eyebrow">Get started</p>
            <h2>Create your account</h2>
            <p>All fields are required. Your account type determines your workspace.</p>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Full name</label>
                    <input asp-for="Name" class="form-control" autocomplete="name" placeholder="Your full name" autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email address</label>
                        <input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">Phone number</label>
                        <input asp-for="Phone" class="form-control" autocomplete="tel" placeholder="Your contact number" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="UserType" class="form-label">I want to</label>
                    <select asp-for="UserType" class="form-select">
                        <option value="">Choose an account type</option>
                        <option value="Farmer">Sell produce as a farmer</option>
                        <option value="Consumer">Buy produce as a consumer</option>
                    </select>
                    <span asp-validation-for="UserType" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="At least 6 characters" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Repeat your password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100">Create account</button>
            </form>

            <p class="text-center mt-4 mb-0">Already registered? <a asp-action="Login">Sign in</a></p>
        </div>
    </section>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
