@model IEnumerable<DigitalAgriculturalMarketplace.Models.Rfq>
@using DigitalAgriculturalMarketplace.Models
@{ViewData["Title"]="RFQ oversight";var quotes=(IEnumerable<Quotation>)ViewBag.Quotations;var allocations=(IEnumerable<QuotationAllocation>)ViewBag.Allocations;}
<div class="container"><div class="page-header"><div><p class="eyebrow">Administration</p><h1>RFQ oversight</h1><p>Read-only monitoring of requests, quotations, allocations, and resulting orders.</p></div></div><div class="row g-3 mb-4"><div class="col"><div class="kpi-card"><span>RFQs</span><strong>@Model.Count()</strong></div></div><div class="col"><div class="kpi-card"><span>Quotations</span><strong>@quotes.Count()</strong></div></div><div class="col"><div class="kpi-card"><span>Allocations</span><strong>@allocations.Count()</strong></div></div></div><div class="panel mb-3"><div class="panel-header"><h2>RFQs</h2></div><div class="table-responsive"><table class="table"><thead><tr><th>Number</th><th>Buyer</th><th>Title</th><th>Status</th><th>Items</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.RfqNumber</td><td>@r.Buyer?.Name</td><td>@r.Title</td><td>@r.Status</td><td>@r.Items.Count</td></tr>}</tbody></table></div></div><div class="panel"><div class="panel-header"><h2>Recent allocations</h2></div><div class="table-responsive"><table class="table"><thead><tr><th>Buyer</th><th>Seller</th><th>Quantity</th><th>Price</th><th>Order</th></tr></thead><tbody>@foreach(var a in allocations){<tr><td>@a.Buyer?.Name</td><td>@a.Seller?.Name</td><td>@a.AcceptedQuantity.ToString("0.###")</td><td>Rs. @a.AcceptedUnitPrice.ToString("N2")</td><td>@a.Order?.OrderNumber</td></tr>}</tbody></table></div></div></div></div>
