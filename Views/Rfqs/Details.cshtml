@model DigitalAgriculturalMarketplace.Models.Rfq
@{ViewData["Title"]=Model.RfqNumber;}
<div class="container"><div class="page-header"><div><p class="eyebrow">@Model.RfqNumber</p><h1>@Model.Title</h1><p>@Model.DeliveryLocation · required @Model.RequiredByDate.ToString("dd MMM yyyy")</p></div><span class="status-pill status-neutral">@Model.Status</span></div>@if(TempData["SuccessMessage"]!=null){<div class="alert alert-success">@TempData["SuccessMessage"]</div>}@if(TempData["ErrorMessage"]!=null){<div class="alert alert-danger">@TempData["ErrorMessage"]</div>}
<div class="panel mb-3"><div class="panel-header"><h2>Requirements</h2></div><div class="table-responsive"><table class="table"><thead><tr><th>Product</th><th>Requested</th><th>Accepted</th><th>Remaining</th><th>Budget</th></tr></thead><tbody>@foreach(var i in Model.Items){<tr><td><strong>@i.CatalogProduct?.Name</strong><div class="product-meta">@i.Specifications</div></td><td>@i.RequestedQuantity.ToString("0.###") @i.UnitOfMeasure?.Code</td><td>@i.AcceptedQuantity.ToString("0.###")</td><td>@((i.RequestedQuantity-i.AcceptedQuantity).ToString("0.###"))</td><td>@(i.MaximumBudgetPerUnit.HasValue?$"Rs. {i.MaximumBudgetPerUnit:N2}":"Not specified")</td></tr>}</tbody></table></div></div>
@if(Model.Status=="Draft"){<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Edit draft</a><form asp-action="Publish" method="post" class="d-inline" data-confirm="Publish this RFQ to eligible sellers?"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-primary">Publish RFQ</button></form>}@if(Model.Status is "Open" or "PartiallyFulfilled"){<form asp-action="Close" method="post" class="d-inline" data-confirm="Close this RFQ?"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-secondary">Close</button></form>}
<section class="mt-4"><div class="page-header"><div><h2 class="h4">Received quotations</h2><p>Only you can compare competing offers.</p></div></div>@if(!Model.Quotations.Any()){<div class="empty-state"><p>No quotations received yet.</p></div>}else{<div class="row g-3">@foreach(var q in Model.Quotations){<div class="col-md-6"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between"><strong>@q.QuotationNumber</strong><span class="status-pill status-neutral">@q.Status</span></div><p class="product-meta mt-2">@q.Seller?.Name · valid to @q.ValidUntil.ToString("dd MMM yyyy")</p><p>@q.Items.Count item(s), @q.Items.Sum(x=>x.OfferedQuantity).ToString("0.###") total units offered</p><a asp-action="QuotationDetails" asp-route-id="@q.Id" class="btn btn-outline-primary btn-sm">Compare and allocate</a></div></div></div>}</div>}</section></div>
