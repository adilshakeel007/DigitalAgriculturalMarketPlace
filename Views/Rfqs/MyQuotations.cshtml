@model IEnumerable<DigitalAgriculturalMarketplace.Models.Quotation>
@{ViewData["Title"]="My quotations";}
<div class="management-shell"><partial name="_FarmerSidebar"/><main class="management-content"><div class="management-header"><div><h1>My quotations</h1><p>Your private offers and accepted quantities.</p></div><a asp-action="Browse" class="btn btn-primary btn-sm">Browse RFQs</a></div>@if(!Model.Any()){<div class="empty-state"><p>No quotations submitted.</p></div>}else{<div class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Quotation</th><th>RFQ</th><th>Status</th><th>Offered</th><th>Accepted</th><th></th></tr></thead><tbody>@foreach(var q in Model){<tr><td>@q.QuotationNumber</td><td>@q.Rfq?.Title</td><td>@q.Status</td><td>@q.Items.Sum(x=>x.OfferedQuantity).ToString("0.###")</td><td>@q.Items.Sum(x=>x.AcceptedQuantity).ToString("0.###")</td><td>@if(q.Status=="Draft"){<a asp-action="EditQuote" asp-route-id="@q.Id" class="btn btn-primary btn-sm">Edit draft</a>}<a asp-action="QuotationDetails" asp-route-id="@q.Id" class="btn btn-secondary btn-sm">View</a></td></tr>}</tbody></table></div></div>}</main></div>
