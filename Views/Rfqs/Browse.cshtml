@model IEnumerable<DigitalAgriculturalMarketplace.Models.Rfq>
@{ViewData["Title"]="Open RFQs";}
<div class="management-shell"><partial name="_FarmerSidebar"/><main class="management-content"><div class="management-header"><div><h1>Open RFQs</h1><p>Requests matching your active, approved, unit-mapped listings.</p></div></div>@if(!Model.Any()){<div class="empty-state"><h2>No eligible RFQs</h2><p>Only exact catalog-product and unit matches appear here.</p></div>}else{<div class="row g-3">@foreach(var r in Model){<div class="col-md-6"><div class="card h-100"><div class="card-body"><span class="product-meta">@r.RfqNumber</span><h2 class="h5">@r.Title</h2><p>@r.DeliveryLocation · @r.RequiredByDate.ToString("dd MMM yyyy")</p><ul>@foreach(var i in r.Items){<li>@i.CatalogProduct?.Name — @i.RequestedQuantity.ToString("0.###") @i.UnitOfMeasure?.Code</li>}</ul><a asp-action="Quote" asp-route-id="@r.Id" class="btn btn-primary btn-sm">Prepare quotation</a></div></div></div>}</div>}</main></div>
