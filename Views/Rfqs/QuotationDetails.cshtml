@model DigitalAgriculturalMarketplace.Models.Quotation
@{ViewData["Title"]=Model.QuotationNumber;int uid=Context.Session.GetInt32("UserId")??0;bool buyer=Model.Rfq?.BuyerId==uid;}
<div class="container"><div class="page-header"><div><p class="eyebrow">@Model.QuotationNumber</p><h1>@Model.Rfq?.Title</h1><p>Seller: @Model.Seller?.Name · valid until @Model.ValidUntil.ToString("dd MMM yyyy")</p></div><span class="status-pill status-neutral">@Model.Status</span></div>@if(TempData["SuccessMessage"]!=null){<div class="alert alert-success">@TempData["SuccessMessage"]</div>}@if(TempData["ErrorMessage"]!=null){<div class="alert alert-danger">@TempData["ErrorMessage"]</div>}<div class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Product</th><th>Offered</th><th>Accepted</th><th>Price/unit</th><th>Delivery</th><th>Allocation</th></tr></thead><tbody>@foreach(var i in Model.Items){var req=Model.Rfq!.Items.Single(x=>x.Id==i.RfqItemId);<tr><td><strong>@i.Product?.Name</strong><div class="product-meta">@req.CatalogProduct?.Name · @i.Product?.UnitOfMeasure?.Code</div></td><td>@i.OfferedQuantity.ToString("0.###")</td><td>@i.AcceptedQuantity.ToString("0.###")</td><td>Rs. @i.UnitPrice.ToString("N2")</td><td>@i.EstimatedDeliveryDate.ToString("dd MMM yyyy")</td><td>@if(buyer&&Model.Status is "Submitted" or "PartiallyAccepted"){<form asp-action="Accept" method="post"><input type="hidden" name="QuotationItemId" value="@i.Id"/><input type="hidden" name="OperationKey" value="@Guid.NewGuid().ToString("N")"/><div class="input-group input-group-sm"><input class="form-control" name="Quantity" type="number" step="1" min="1" max="@Math.Min(i.OfferedQuantity-i.AcceptedQuantity,req.RequestedQuantity-req.AcceptedQuantity)"/><button class="btn btn-primary">Accept</button></div></form>}else{<span class="product-meta">@i.Allocations.Count allocation(s)</span>}</td></tr>}</tbody></table></div></div>@if(!buyer&&Model.Status=="Submitted"){<form asp-action="Withdraw" method="post" class="mt-3" data-confirm="Withdraw this quotation?"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-outline-danger">Withdraw quotation</button></form>}@if(Model.Items.SelectMany(x=>x.Allocations).Any()){<div class="panel mt-3"><div class="panel-header"><h2>Resulting orders</h2></div><div class="panel-body">@foreach(var a in Model.Items.SelectMany(x=>x.Allocations)){<div><strong>@(a.Order?.OrderNumber ?? $"Order #{a.OrderId}")</strong> · @a.AcceptedQuantity.ToString("0.###") at Rs. @a.AcceptedUnitPrice.ToString("N2")</div>}</div></div>}</div>
