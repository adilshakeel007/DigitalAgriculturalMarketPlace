@model DigitalAgriculturalMarketplace.ViewModels.QuotationCreateViewModel
@using DigitalAgriculturalMarketplace.Models
@{ var rfq=(Rfq)ViewBag.Rfq; var products=(IEnumerable<Product>)ViewBag.Products; ViewData["Title"]="Submit quotation"; }
<div class="management-shell"><partial name="_FarmerSidebar"/><main class="management-content">
<div class="management-header"><div><h1>Quote @rfq.RfqNumber</h1><p>Select only your eligible listings that exactly match each requirement.</p></div></div>
<form method="post"><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="RfqId"/><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="panel mb-3"><div class="panel-body"><div class="row g-3"><div class="col-md-4"><label asp-for="ValidUntil" class="form-label">Valid until</label><input asp-for="ValidUntil" class="form-control"/></div><div class="col-md-8"><label asp-for="Notes" class="form-label"></label><input asp-for="Notes" class="form-control"/></div></div></div></div>
<div class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Requirement</th><th>Your listing</th><th>Offered qty</th><th>Unit price</th><th>Delivery</th></tr></thead><tbody>
@for(int n=0;n<Model.Items.Count;n++){var input=Model.Items[n];var req=rfq.Items.Single(i=>i.Id==input.RfqItemId);var matches=products.Where(p=>p.CatalogProductId==req.CatalogProductId&&p.UnitOfMeasureId==req.UnitOfMeasureId);<tr><td><input type="hidden" asp-for="Items[n].RfqItemId"/><strong>@req.CatalogProduct?.Name</strong><div class="product-meta">@req.RequestedQuantity.ToString("0.###") @req.UnitOfMeasure?.Code</div></td><td><select asp-for="Items[n].ProductId" class="form-select"><option value="0">Do not quote</option>@foreach(var p in matches){<option value="@p.Id">@p.Name (@((p.AvailableQuantity??p.Quantity).ToString("0.###")) available)</option>}</select></td><td><input asp-for="Items[n].OfferedQuantity" class="form-control" step="0.001" min="0"/></td><td><input asp-for="Items[n].UnitPrice" class="form-control" step="0.01" min="0"/></td><td><input asp-for="Items[n].EstimatedDeliveryDate" class="form-control"/></td></tr>}
</tbody></table></div></div><div class="d-flex gap-2 mt-3"><button class="btn btn-secondary" name="command" value="draft">Save draft</button><button class="btn btn-primary" name="command" value="submit">Submit private quotation</button></div></form></main></div>
