@model IEnumerable<DigitalAgriculturalMarketplace.Models.Rfq>
@{ViewData["Title"]="My RFQs";}
<div class="container"><div class="page-header"><div><p class="eyebrow">Bulk buying</p><h1>My RFQs</h1><p>Request competitive offers from eligible agricultural sellers.</p></div><a asp-action="Create" class="btn btn-primary">Create RFQ</a></div>
@if(!Model.Any()){<div class="empty-state"><h2>No RFQs yet</h2><p>Create a request with one or more products.</p></div>}else{<div class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>RFQ</th><th>Title</th><th>Items</th><th>Status</th><th>Required by</th><th></th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.RfqNumber</td><td><strong>@r.Title</strong></td><td>@r.Items.Count</td><td><span class="status-pill status-neutral">@r.Status</span></td><td>@r.RequiredByDate.ToString("dd MMM yyyy")</td><td><a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-secondary">View</a></td></tr>}</tbody></table></div></div>}</div>
