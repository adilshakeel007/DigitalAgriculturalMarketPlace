@model DigitalAgriculturalMarketplace.ViewModels.RfqCreateViewModel
@{ViewData["Title"]="Create RFQ";}
<div class="container"><div class="page-header"><div><p class="eyebrow">Bulk buying</p><h1>Create request for quotation</h1><p>Add up to five product requirements. Quantities use the explicit selected unit.</p></div><a asp-action="Index" class="btn btn-secondary">Back</a></div>
<form method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="panel mb-3"><div class="panel-body"><div class="row g-3"><div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control"/></div><div class="col-md-4"><label asp-for="RequiredByDate" class="form-label">Required by</label><input asp-for="RequiredByDate" class="form-control"/></div><div class="col-12"><label asp-for="DeliveryLocation" class="form-label">Delivery location</label><input asp-for="DeliveryLocation" class="form-control"/></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div></div></div></div>
<div class="panel"><div class="panel-header"><h2>Requested products</h2></div><div class="panel-body d-grid gap-3">@for(int i=0;i<5;i++){var existing=i<Model.Items.Count?Model.Items[i]:new DigitalAgriculturalMarketplace.ViewModels.RfqItemInputViewModel();<div class="row g-2 border-bottom pb-3"><div class="col-md-3"><label class="form-label">Catalog product</label><select class="form-select" name="Items[@i].CatalogProductId"><option value="0">Unused row</option>@foreach(var p in Model.CatalogProducts){<option value="@p.Id" selected="@(existing.CatalogProductId==p.Id)">@p.Name</option>}</select></div><div class="col-md-2"><label class="form-label">Unit</label><select class="form-select" name="Items[@i].UnitOfMeasureId"><option value="0">Select</option>@foreach(var u in Model.Units){<option value="@u.Id" selected="@(existing.UnitOfMeasureId==u.Id)">@u.Name</option>}</select></div><div class="col-md-2"><label class="form-label">Quantity</label><input class="form-control" type="number" step="0.001" min="0" name="Items[@i].RequestedQuantity" value="@(existing.RequestedQuantity==0?null:existing.RequestedQuantity)"/></div><div class="col-md-2"><label class="form-label">Max/unit</label><input class="form-control" type="number" step="0.01" min="0" name="Items[@i].MaximumBudgetPerUnit" value="@existing.MaximumBudgetPerUnit"/></div><div class="col-md-3"><label class="form-label">Specifications</label><input class="form-control" name="Items[@i].Specifications" value="@existing.Specifications"/></div></div>}</div></div><button class="btn btn-primary mt-3">Save draft</button></form></div>
@section Scripts{@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}}
